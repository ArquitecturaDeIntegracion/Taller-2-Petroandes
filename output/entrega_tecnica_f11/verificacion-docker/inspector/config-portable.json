{
  "mcpServers": {
    "historico": {
      "command": "python",
      "args": [
        "${APP_ROOT}/tests/f7_stdio_fixture.py",
        "${TMPDIR}/petroandes-entrega-zm4jaj19/historico/historico.json"
      ],
      "cwd": "${APP_ROOT}",
      "env": {
        "PETROANDES_CACHE_DIR": "${PROJECT_ROOT}/petroandes-data/cache",
        "PETROANDES_MODELS_DIR": "${MODELS_DIR}",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "sin_indice": {
      "command": "python",
      "args": [
        "${APP_ROOT}/tests/f7_stdio_fixture.py",
        "${TMPDIR}/petroandes-entrega-zm4jaj19/historico/sin_indice.json"
      ],
      "cwd": "${APP_ROOT}",
      "env": {
        "PETROANDES_CACHE_DIR": "${PROJECT_ROOT}/petroandes-data/cache",
        "PETROANDES_MODELS_DIR": "${MODELS_DIR}",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "habitual": {
      "command": "python",
      "args": [
        "-m",
        "petroandes.mcp_server",
        "--profile",
        "laboratorio"
      ],
      "cwd": "${APP_ROOT}",
      "env": {
        "PETROANDES_CACHE_DIR": "${PROJECT_ROOT}/petroandes-data/cache",
        "PETROANDES_MODELS_DIR": "${MODELS_DIR}",
        "PETROANDES_ARTIFACTS_DIR": "${TMPDIR}/petroandes-entrega-zm4jaj19/historico/despliegue",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "sin_catalogo": {
      "command": "python",
      "args": [
        "-m",
        "petroandes.mcp_server",
        "--profile",
        "laboratorio"
      ],
      "cwd": "${APP_ROOT}",
      "env": {
        "PETROANDES_CACHE_DIR": "${PROJECT_ROOT}/petroandes-data/cache",
        "PETROANDES_MODELS_DIR": "${MODELS_DIR}",
        "PETROANDES_ARTIFACTS_DIR": "${TMPDIR}/petroandes-entrega-zm4jaj19/historico/sin-catalogo",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  }
}
