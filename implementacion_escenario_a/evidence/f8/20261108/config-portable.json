{
  "mcpServers": {
    "historico": {
      "command": "python",
      "args": [
        "${APP_ROOT}/tests/f7_stdio_fixture.py",
        "${TMPDIR}/petroandes-f8-g0_rw822/historico.json"
      ],
      "cwd": "${APP_ROOT}",
      "env": {
        "PETROANDES_CACHE_DIR": ".cache",
        "PETROANDES_MODELS_DIR": ".cache/models",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "sin_indice": {
