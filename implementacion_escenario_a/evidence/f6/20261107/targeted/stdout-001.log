.{"consulta": "Transcriba el rengl\u00f3n de presi\u00f3n de descarga de la ficha para P-101.", "respuesta": "Lectura hist\u00f3rica. Extractos documentales.\n\nPar\u00e1metro | Valor de dise\u00f1o | L\u00edmite de alarma\nPresi\u00f3n de descarga | 1.180 psi | 1.240 psi\n[FIC-ACT-P101, versi\u00f3n 2, secci\u00f3n 2, p. 1\u20131]", "traza": {"correlation_id": "df347e20-86d5-4fcd-ad74-53813227db43", "generation_id": "41befd85-9a59-5324-8d06-8a67e6d9e137", "revision_gobierno": 13, "operacion": "responder", "tiempos_ms": {"gobierno": 2.5521240022499114, "generacion": 89.20922199831693, "catalogo_publicado": 5.864183000085177, "exacta": 0.15683400124544278, "embedding": 42.341732998465886, "densa": 8.435624000412645, "lexica": 4.730571999971289, "fusion": 0.1298809984291438, "composicion": 1.7777149987523444, "revalidacion": 2.6953340020554606, "total": 158.9795120016788}, "top_k": 10, "profundidad_rama": 10, "rrf_k": 60, "fusion": "rrf", "tokenizacion": "bm25-codes-es-1.0.0", "codigos": "codes-es-1.0.0", "desempate": "coincidencia_exacta_y_chunk_id", "modo": "texto", "prefiltro_fragmentos": 58, "candidatos": {"densa": ["5c707f27-d5b8-5020-94ea-22d886a09bb2", "cdada850-4eeb-5090-b792-5bb1d4df471f", "13968c26-494d-5313-9c14-1950fc902b52", "6cdeae48-b1a2-5f43-b9b2-9c8f5cdcc82c", "d7a8078e-2138-57f1-a6cb-c505b153c46d", "2ec1db42-e181-599c-8569-814059052f27", "11f9d6b7-dd0b-5996-8471-965fe4a88877", "b5746689-5b24-5761-be72-8ce423d64688", "f50402e5-df3a-5241-bf20-dcf76c9d81bf", "119295cd-cd85-5d9b-9bea-da6b854da506"], "lexica": ["5c707f27-d5b8-5020-94ea-22d886a09bb2", "cdada850-4eeb-5090-b792-5bb1d4df471f", "6cdeae48-b1a2-5f43-b9b2-9c8f5cdcc82c", "13968c26-494d-5313-9c14-1950fc902b52", "d7a8078e-2138-57f1-a6cb-c505b153c46d", "f50402e5-df3a-5241-bf20-dcf76c9d81bf", "b5746689-5b24-5761-be72-8ce423d64688", "2ec1db42-e181-599c-8569-814059052f27", "28e9aeb6-998c-5a3a-abe8-f37fd48a59ee", "66706ea4-94e4-5701-9d44-3af5863c9df9"], "exacta": ["13968c26-494d-5313-9c14-1950fc902b52", 