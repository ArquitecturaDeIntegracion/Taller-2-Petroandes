.{"consulta": "Localice el l\u00edmite de incertidumbre de medici\u00f3n de RES-CREG-0043-2024.", "respuesta": "Lectura hist\u00f3rica. Extractos documentales.\n\nLa incertidumbre combinada del sistema de medici\u00f3n en los puntos de transferencia de custodia no exceder\u00e1 del cero coma tres por ciento (0,3 %).\n[RES-CREG-0043-2024, sin versi\u00f3n, secci\u00f3n articulo-2, p. 1\u20131]", "traza": {"correlation_id": "fb19dab0-6fae-40ec-a5c2-598e8ebdf5b6", "generation_id": "41befd85-9a59-5324-8d06-8a67e6d9e137", "revision_gobierno": 13, "operacion": "responder", "tiempos_ms": {"gobierno": 1.5740269991511013, "generacion": 87.83630700054346, "catalogo_publicado": 7.93605699800537, "exacta": 0.18072800230584107, "embedding": 59.39238300197758, "densa": 5.527191002329346, "lexica": 3.3188809975399636, "fusion": 0.1432290009688586, "composicion": 2.30742699932307, "revalidacion": 1.4362410001922399, "total": 170.61647800073843}, "top_k": 10, "profundidad_rama": 10, "rrf_k": 60, "fusion": "rrf", "tokenizacion": "bm25-codes-es-1.0.0", "codigos": "codes-es-1.0.0", "desempate": "coincidencia_exacta_y_chunk_id", "modo": "texto", "prefiltro_fragmentos": 58, "candidatos": {"densa": ["eacdd529-b0de-5c1b-9725-7bf43fac25f5", "248a3e1a-c35a-57b6-8664-356ba4dfc456", "3685ab04-4611-53c4-9f85-7558344b3e6d", "7c30af4b-2d3a-5bc6-a88e-7e47eb1025bc", "e3e7596e-ab2a-544a-9255-efc608e43bd6", "53321bbb-4bd2-5d55-a5f3-219a17bd5907", "9e39bb70-2493-5ac5-a831-d88c1f3a5618", "b5746689-5b24-5761-be72-8ce423d64688", "b39f1831-2216-5f35-999c-0488becfd23f", "d4bbfa98-a25a-54e1-87af-dd59ac5a1b82"], "lexica": ["eacdd529-b0de-5c1b-9725-7bf43fac25f5", "3685ab04-4611-53c4-9f85-7558344b3e6d", "7c30af4b-2d3a-5bc6-a88e-7e47eb1025bc", "53321bbb-4bd2-5d55-a5f3-219a17bd5907", "248a3e1a-c35a-57b6-8664-356ba4dfc456", "e3e7596e-ab2a-544a-9255-efc608e43bd6", "d7a8078e-2138-57f1-a6cb-c505b153c46d", "391ac6ed-821c-5834-a3ec-db648ebea66a", "5c707f27-d5b8-5020-94ea-22d886a09bb2", "8164fe95-9daf-5a10-b246-6240a6f