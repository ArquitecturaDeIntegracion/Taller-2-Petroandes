{
  "mcpServers": {
    "historico": {
      "command": "python",
      "args": [
        "${APP_ROOT}/tools/f9_observe.py",
        "${USER_HOME}/petroandes-f9-hrgwafb0/historico.json"
      ],
      "cwd": "${APP_ROOT}",
      "env": {
        "PETROANDES_CACHE_DIR": "${USER_HOME}/cache",
        "PETROANDES_MODELS_DIR": "${MODELS_DIR}",
        "PETROANDES_AUDIT_DIR": "/f9-output/mcp-audit",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "auditoria": {
      "command": "python",
      "args": [
        "${APP_ROOT}/tools/f9_observe.py",
        "${USER_HOME}/petroandes-f9-hrgwafb0/auditoria.json"
      ],
      "cwd": "${APP_ROOT}",
      "env": {
        "PETROANDES_CACHE_DIR": "${USER_HOME}/cache",
        "PETROANDES_MODELS_DIR": "${MODELS_DIR}",
        "PETROANDES_AUDIT_DIR": "/f9-output/mcp-audit",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  }
