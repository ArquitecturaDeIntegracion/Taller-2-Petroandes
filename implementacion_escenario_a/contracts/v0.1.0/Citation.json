{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "doc_id": {
      "minLength": 1,
      "title": "Doc Id",
      "type": "string"
    },
    "version_documental": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Version Documental"
    },
    "pdf_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Pdf Sha256",
      "type": "string"
    },
    "section_id": {
      "minLength": 1,
      "title": "Section Id",
      "type": "string"
    },
    "pagina_inicio": {
      "minimum": 1,
      "title": "Pagina Inicio",
      "type": "integer"
    },
    "pagina_fin": {
      "minimum": 1,
      "title": "Pagina Fin",
      "type": "integer"
    }
  },
  "required": [
    "doc_id",
    "version_documental",
    "pdf_sha256",
    "section_id",
    "pagina_inicio",
    "pagina_fin"
  ],
  "title": "Citation",
  "type": "object"
}
