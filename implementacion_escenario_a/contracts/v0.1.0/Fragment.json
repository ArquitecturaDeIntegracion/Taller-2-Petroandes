{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "doc_id": {
      "minLength": 1,
      "title": "Doc Id",
      "type": "string"
    },
    "version_documental": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Version Documental"
    },
    "pdf_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Pdf Sha256",
      "type": "string"
    },
    "chunk_id": {
      "minLength": 1,
      "title": "Chunk Id",
      "type": "string"
    },
    "section_id": {
      "minLength": 1,
      "title": "Section Id",
      "type": "string"
    },
    "titulo_seccion": {
      "minLength": 1,
      "title": "Titulo Seccion",
      "type": "string"
    },
    "pagina_inicio": {
      "minimum": 1,
      "title": "Pagina Inicio",
      "type": "integer"
    },
    "pagina_fin": {
      "minimum": 1,
      "title": "Pagina Fin",
      "type": "integer"
    },
    "parte": {
      "minimum": 1,
      "title": "Parte",
      "type": "integer"
    },
    "orden": {
      "minimum": 0,
      "title": "Orden",
      "type": "integer"
    },
    "parent_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parent Id"
    },
    "texto": {
      "minLength": 1,
      "title": "Texto",
      "type": "string"
    },
    "parser_version": {
      "minLength": 1,
      "title": "Parser Version",
      "type": "string"
    },
    "particion": {
      "const": "structural-es-1.0.0",
      "title": "Particion",
      "type": "string"
    },
    "bundle": {
      "const": "e5small-es-1.0.0",
      "title": "Bundle",
      "type": "string"
    },
    "tokens_entrada": {
      "maximum": 448,
      "minimum": 1,
      "title": "Tokens Entrada",
      "type": "integer"
    },
    "contenido_no_confiable": {
      "const": true,
      "default": true,
      "title": "Contenido No Confiable",
      "type": "boolean"
    }
  },
  "required": [
    "doc_id",
    "version_documental",
    "pdf_sha256",
    "chunk_id",
    "section_id",
    "titulo_seccion",
    "pagina_inicio",
    "pagina_fin",
    "parte",
    "orden",
    "parent_id",
    "texto",
    "parser_version",
    "particion",
    "bundle",
    "tokens_entrada"
  ],
  "title": "Fragment",
  "type": "object"
}
