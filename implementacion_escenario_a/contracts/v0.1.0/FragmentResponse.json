{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "estado": {
      "enum": [
        "encontrado",
        "denegado",
        "error"
      ],
      "title": "Estado",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "generation_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Generation Id"
    },
    "revision_gobierno": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Revision Gobierno"
    },
    "partes": {
      "default": [],
      "items": {
        "$ref": "Fragment.json"
      },
      "title": "Partes",
      "type": "array"
    },
    "citas": {
      "default": [],
      "items": {
        "$ref": "Citation.json"
      },
      "title": "Citas",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "enum": [
            "evidencia_no_autorizada",
            "referencia_ambigua",
            "indice_no_listo",
            "servicio_no_disponible"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "estado",
    "correlation_id",
    "generation_id",
    "revision_gobierno"
  ],
  "title": "FragmentResponse",
  "type": "object"
}
